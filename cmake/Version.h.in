// Version.h (generated by CMake from project(myengine VERSION ...) in the root CMakeLists.txt: the only place the version is written)
#pragma once

#define MYENGINE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define MYENGINE_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define MYENGINE_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define MYENGINE_VERSION_STRING "@PROJECT_VERSION@"
// the commit the build was configured at (the package script writes the exact one to version.txt)
#define MYENGINE_GIT_COMMIT "@MYENGINE_GIT_COMMIT@"
