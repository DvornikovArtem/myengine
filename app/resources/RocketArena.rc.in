// RocketArena.rc (generated from RocketArena.rc.in by CMake): the icon and the version info of the exe
#include <windows.h>

// id 1: the first icon of the exe is the one the Explorer shows; the window class loads it by this id (Window.cpp)
1 ICON "RocketArena.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "myengine team (ITMO game engine architecture course)\0"
            VALUE "FileDescription", "@MYENGINE_RC_DESCRIPTION@\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "@MYENGINE_RC_PRODUCT@\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 the myengine team. Third-party licenses: the licenses folder.\0"
            VALUE "OriginalFilename", "@MYENGINE_RC_FILE@\0"
            VALUE "ProductName", "@MYENGINE_RC_PRODUCT@\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@ (@MYENGINE_GIT_COMMIT@)\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
